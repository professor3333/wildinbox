# Copy to .env and adjust. Contains no secrets; local development defaults only.
WILDINBOX_CONFIG_PATH=configs/example.yaml
WILDINBOX_DATA_DIR=data
WILDINBOX_DATABASE_URL=postgresql+psycopg://wildinbox:wildinbox@localhost:5432/wildinbox
WILDINBOX_REDIS_URL=redis://localhost:6379/0

# Object storage: "s3" (any S3-compatible service; SeaweedFS in docker compose) or "local" (a directory)
WILDINBOX_OBJECT_STORE_BACKEND=s3
WILDINBOX_OBJECT_STORE_URL=http://localhost:9000
WILDINBOX_OBJECT_STORE_BUCKET=wildinbox
# Set these in your own .env; never commit real credentials.
WILDINBOX_OBJECT_STORE_ACCESS_KEY=
WILDINBOX_OBJECT_STORE_SECRET_KEY=

# "rq" (Redis workers) or "inline" (process in the API; development only)
WILDINBOX_DISPATCH=rq

# Access: "tokens" (default; set WILDINBOX_API_TOKENS from `wildinbox token new NAME`)
# or "disabled" (local development only).
WILDINBOX_AUTH=disabled
# WILDINBOX_API_TOKENS={"alice": "<sha256 of alice's token>"}

# Logs: "text" or "json"
WILDINBOX_LOG_FORMAT=text

# Input limits
WILDINBOX_MAX_FILES_PER_BATCH=2000
WILDINBOX_MAX_FILE_BYTES=20971520
WILDINBOX_MAX_BATCH_BYTES=1073741824

# Tests: database the API tests may wipe (e.g. a throwaway Postgres container)
# WILDINBOX_TEST_DATABASE_URL=postgresql+psycopg://wildinbox:wildinbox@localhost:55432/wildinbox
