# /etc/wildinbox/secrets.env on the staging VM: chmod 600, owned by ubuntu,
# never committed or copied off the VM. Generate the values as shown.

# openssl rand -hex 24
POSTGRES_PASSWORD=

# One entry per person or service; values are SHA-256 hashes, not tokens.
# `uv run wildinbox token new owner alice ...` prints the tokens and this whole line.
# Single quotes: the file is read by both bash and Compose.
WILDINBOX_API_TOKENS='{"owner": "<sha256>", "loadtest": "<sha256>"}'

# Optional: principals allowed to record reviews on someone else's behalf (an
# annotation importer). Everyone else's reviews carry their own principal.
# WILDINBOX_REVIEW_DELEGATES='["importer"]'

# The release this deployment must serve; /ready fails otherwise.
WILDINBOX_EXPECTED_RELEASE=finetune-e3-deep-balanced@7a25aea97c76

# Worker processes (2 on the declared 2-vCPU hardware: one worker leaves ~50% of
# the CPU idle; see reports/staging), and PyTorch threads per worker (unset: one per vCPU).
WILDINBOX_WORKERS=2
# WILDINBOX_TORCH_THREADS=2
